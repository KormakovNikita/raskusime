PORT=3000
TINKOFF_TERMINAL_KEY=your_terminal_key_here
# If the password contains # or spaces, wrap it in double quotes:
TINKOFF_SECRET_PASSWORD="your_secret_password_here"
# Public site URL (no trailing slash). Must be https:// on production.
BASE_URL=http://localhost:3000
# Redirect to HTTPS when behind nginx with X-Forwarded-Proto (production)
FORCE_HTTPS=false

# LLM — ProxyAPI recommended for RU VPS (ruble billing)
OPENAI_API_KEY=your_proxyapi_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Fiscal receipt (T-Bank Init Receipt object)
RECEIPT_ENABLED=true
TINKOFF_TAXATION=usn_income
RECEIPT_TAX=none
RECEIPT_ITEM_NAME=Предсказание Раскуси

# Secret for POST /api/refund (full Cancel). Leave empty to disable endpoint.
REFUND_ADMIN_KEY=change_me_to_a_long_random_string

# Yandex Metrika counter id (digits only). Leave empty to disable.
YANDEX_METRIKA_ID=112027032

# Yandex RSYA — block ids from partner.yandex.ru (format R-A-1234567-1)
# Keep disabled until Partner approves the site (YANDEX_RSYA_ENABLED=true after moderation).
YANDEX_RSYA_ENABLED=false
YANDEX_RSYA_BLOCK_CONTENT=
YANDEX_RSYA_BLOCK_FOOTER=
# One line from Partner → Site → ads.txt (paste when available)
YANDEX_RSYA_ADS_TXT=

# Only if Node fails with SELF_SIGNED_CERT_IN_CHAIN to T-Bank/ProxyAPI.
# Run: sudo bash scripts/fix-vps-ca.sh then set INSECURE_TLS=false
INSECURE_TLS=false

# Free predictions (default). Set FREE_MODE=false to re-enable T-Bank payments.
FREE_MODE=true
# Max fortune requests per IP per hour (free mode)
FORTUNE_RATE_LIMIT=20
