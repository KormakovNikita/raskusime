PORT=3000
TINKOFF_TERMINAL_KEY=your_terminal_key_here
# If the password contains # or spaces, wrap it in double quotes:
TINKOFF_SECRET_PASSWORD="your_secret_password_here"
BASE_URL=http://localhost:3000

# LLM — любой OpenAI-совместимый Chat Completions API.
# OpenAI напрямую с VPS в РФ обычно недоступен (403 unsupported_country).
# Рекомендуемый вариант для РФ с оплатой в рублях: ProxyAPI
OPENAI_API_KEY=your_proxyapi_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Set to true to simulate T-Bank payments without real credentials
DEMO_MODE=true
